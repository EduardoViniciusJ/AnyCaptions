{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyCaptions",
  "version": "0.1.1",
  "identifier": "com.anycaptions.app",
  "build": {
    "beforeDevCommand": { "script": "npm --prefix ../frontend run dev", "cwd": "." },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": { "script": "npm --prefix ../frontend run build", "cwd": "." },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [{
      "label": "overlay",
      "create": false,
      "title": "AnyCaptions",
      "width": 800,
      "height": 160,
      "minWidth": 320,
      "minHeight": 160,
      "maxHeight": null,
      "decorations": false,
      "transparent": true,
      "alwaysOnTop": true,
      "skipTaskbar": false,
      "resizable": true,
      "maximizable": false,
      "shadow": false,
      "visible": false,
      "focus": false,
      "backgroundColor": "#00000000"
    }],
    "security": {
      "capabilities": ["overlay"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'",
      "devCsp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "EduardoViniciusJ",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "local-data/nemo-speech/build-vulkan-asr/bin/*.dll": "./",
      "models/asr/nemotron-3.5-asr-streaming-0.6b/*": "models/asr/nemotron-3.5-asr-streaming-0.6b/",
      "models/translation/opus-mt-en-pt/*": "models/translation/opus-mt-en-pt/",
      "models/translation/opus-mt-pt-en/*": "models/translation/opus-mt-pt-en/"
    }
  }
}
