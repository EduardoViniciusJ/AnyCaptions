---
import Layout from '../layouts/Layout.astro';
import { CaptionPreview } from '../features/preview/CaptionPreview';
import { DictationPreview } from '../features/preview/DictationPreview';
import { Button } from '../components/ui/button';
import { ButtonLink } from '../components/ButtonLink';
import { getLatestRelease } from '../lib/api/releases';
const release = await getLatestRelease();
const hasInstaller = release?.hasInstaller ?? false;
---
<Layout title="Legendas em tempo real" description="Transcreva e traduza o áudio de jogos, vídeos e chamadas no Windows. Fale em vez de digitar com ditado local.">
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'AnyCaptions',
    operatingSystem: 'Windows 11',
    applicationCategory: 'UtilitiesApplication',
    description: 'Legendas em tempo real de qualquer áudio do computador, com reconhecimento de voz e tradução rodando localmente. Inclui ditado por voz colado em qualquer aplicativo.',
    url: 'https://anycaptions.app',
    image: 'https://anycaptions.app/og.png',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
    author: { '@type': 'Person', name: 'Eduardo Vinicius', url: 'https://github.com/EduardoViniciusJ' },
  })} />
  <section class="hero container">
    <h1>Legendas em tempo real</h1>
    <p class="hero-copy">
      <strong>Transcreva e traduza</strong> o áudio de jogos, vídeos e chamadas.<br class="desktop-break" />
      <strong>Fale em vez de digitar.</strong> Suas palavras viram texto.<br class="desktop-break" />
      <strong>Offline</strong> no seu computador.
    </p>
    <div class="hero-actions" id="download">
      {hasInstaller
        ? <ButtonLink variant="outline" className="hero-download h-12 px-5" id="download-link" href="/account" title="Entre com Google, GitHub ou Discord para baixar.">Baixar</ButtonLink>
        : <Button variant="outline" className="hero-download h-12 px-5" type="button" disabled title="O instalador estará disponível após a publicação da versão.">Baixar</Button>}
    </div>
  </section>
  <script>
    import { currentAccount } from '../features/auth/auth-api';
    const link = document.getElementById('download-link');
    if (link instanceof HTMLAnchorElement && await currentAccount()) {
      const api = (import.meta.env.PUBLIC_API_URL || '/api').replace(/\/$/, '');
      link.href = `${api}/releases/latest/download`;
      link.removeAttribute('title');
    }
  </script>
  <CaptionPreview client:load />
  <DictationPreview client:visible />
</Layout>
