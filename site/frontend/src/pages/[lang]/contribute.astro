---
import ContributePage from '../../components/pages/ContributePage.astro';
import { defaultLang, isLang } from '../../i18n';
const { lang } = Astro.params;
if (lang === defaultLang) return Astro.redirect('/contribute', 301);
if (!lang || !isLang(lang)) return new Response(null, { status: 404 });
---
<ContributePage lang={lang} />
