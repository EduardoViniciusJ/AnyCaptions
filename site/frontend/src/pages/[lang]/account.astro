---
import AccountPage from '../../components/pages/AccountPage.astro';
import { defaultLang, isLang } from '../../i18n';
const { lang } = Astro.params;
if (lang === defaultLang) return Astro.redirect('/account', 301);
if (!lang || !isLang(lang)) return new Response(null, { status: 404 });
---
<AccountPage lang={lang} />
