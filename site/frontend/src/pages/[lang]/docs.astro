---
import DocsPage from '../../components/pages/DocsPage.astro';
import { defaultLang, isLang } from '../../i18n';
const { lang } = Astro.params;
if (lang === defaultLang) return Astro.redirect('/docs', 301);
if (!lang || !isLang(lang)) return new Response(null, { status: 404 });
---
<DocsPage lang={lang} />
