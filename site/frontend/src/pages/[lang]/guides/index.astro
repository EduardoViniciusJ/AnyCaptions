---
import GuidesIndexPage from '../../../components/pages/GuidesIndexPage.astro';
import { defaultLang, isLang } from '../../../i18n';
const { lang } = Astro.params;
if (lang === defaultLang) return Astro.redirect('/guides', 301);
if (!lang || !isLang(lang)) return new Response(null, { status: 404 });
---
<GuidesIndexPage lang={lang} />
