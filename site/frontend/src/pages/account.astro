---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Minha conta" description="Entre na sua conta AnyCaptions.">
  <section class="container account-page">
    <div class="account-panel">
      <p class="kicker">SUA CONTA</p>
      <h1>Bem-vindo ao AnyCaptions.</h1>
      <p>A conta é opcional. Você pode baixar e usar as legendas sem fazer login.</p>
      <div id="account-content" aria-live="polite"><p>Verificando sessão…</p></div>
      <p id="account-error" class="form-error" role="alert" hidden></p>
    </div>
  </section>
</Layout>
<script>
  import { currentAccount, loginUrl, logout } from '../features/auth/auth-api';

  const content = document.getElementById('account-content');
  const error = document.getElementById('account-error');
  if (new URLSearchParams(location.search).get('login') === 'failed' && error) {
    error.textContent = 'Não foi possível entrar. Tente novamente.';
    error.hidden = false;
  }

  async function render() {
    if (!content) return;
    const user = await currentAccount();
    content.replaceChildren();
    if (user) {
      const card = document.createElement('div');
      card.className = 'account-identity';
      if (user.avatarUrl) {
        const avatar = document.createElement('img');
        avatar.src = user.avatarUrl;
        avatar.alt = '';
        avatar.referrerPolicy = 'no-referrer';
        card.append(avatar);
      }
      const details = document.createElement('div');
      const name = document.createElement('strong');
      name.textContent = user.name;
      const email = document.createElement('span');
      email.textContent = user.email ?? 'E-mail não fornecido pelo provedor';
      details.append(name, email);
      card.append(details);
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'button secondary';
      button.textContent = 'Sair da conta';
      button.addEventListener('click', async () => {
        try {
          if (!await logout()) throw new Error('logout failed');
          location.reload();
        } catch {
          if (error) { error.textContent = 'Não foi possível sair. Tente novamente.'; error.hidden = false; }
        }
      });
      content.append(card, button);
      return;
    }
    const list = document.createElement('div');
    list.className = 'login-options';
    for (const [provider, label] of [
      ['discord', 'Discord'], ['google', 'Google'], ['github', 'GitHub']
    ] as const) {
      const link = document.createElement('a');
      link.href = loginUrl(provider);
      link.className = 'button secondary';
      const icon = document.createElement('span');
      icon.className = `provider-icon ${provider}`;
      icon.textContent = provider === 'github' ? '⌘' : provider === 'discord' ? '◉' : 'G';
      icon.setAttribute('aria-hidden', 'true');
      link.append(icon, document.createTextNode(`Entrar com ${label}`));
      list.append(link);
    }
    content.append(list);
  }
  void render();
</script>
