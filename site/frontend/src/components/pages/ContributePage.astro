---
import Layout from '../../layouts/Layout.astro';
import { messages, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = messages[lang].contribute;
const repo = 'https://github.com/EduardoViniciusJ/AnyCaptions';
---
<Layout lang={lang} title={t.title} description={t.description}>
  <section class="container contribute-page">
    <h1>{t.heading}</h1>
    <p>{t.sub}</p>
    <a class="btn btn-outline contribute-issue h-12 px-5" href={`${repo}/issues/new/choose`} target="_blank" rel="noreferrer">{t.issueButton} ↗</a>
    <div class="contribute-repository card card-border bg-base-200 flex-row items-center justify-between gap-6 p-6 max-sm:flex-col max-sm:items-start">
      <h2>{t.repoHeading}</h2>
      <a class="btn btn-outline h-12 px-5" href={repo} target="_blank" rel="noreferrer">{t.repoButton} ↗</a>
    </div>
  </section>
</Layout>
