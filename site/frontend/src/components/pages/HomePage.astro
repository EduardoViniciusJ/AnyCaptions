---
import Layout from '../../layouts/Layout.astro';
import { Captions, Mic, WifiOff } from '@lucide/astro';
import DemoReel from '../DemoReel.astro';
import DemoPlayer from '../DemoPlayer.astro';
import { getLatestRelease } from '../../lib/api/releases';
import { localePath, messages, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = messages[lang].home;
const release = await getLatestRelease();
const hasInstaller = release?.hasInstaller ?? false;
const repo = 'https://github.com/EduardoViniciusJ/AnyCaptions';

// O título e as três linhas entram palavra por palavra, como uma legenda ao vivo, em loop.
let wordIndex = 0;
const toWords = (text: string, strong: boolean) =>
  text.split(/\s+/).filter(Boolean).map(word => ({ word, strong, delay: 0.2 + 0.09 * wordIndex++ }));
const titleWords = toWords(t.heroTitle, false);
const heroIcons = [Captions, Mic, WifiOff];
const heroLines = t.heroLines.map((line, index) => ({
  Icon: heroIcons[index] ?? Captions,
  words: [...toWords(line.lead, true), ...toWords(line.rest, false)],
}));
const caretDelay = 0.2 + 0.09 * wordIndex;

// A seção do GitHub usa o mesmo efeito de legenda, com a própria sequência: ícone, título e frase.
wordIndex = 0;
const githubIconDelay = 0.2 + 0.09 * wordIndex++;
const githubTitleWords = toWords(t.github.title, false);
const githubSubWords = toWords(t.github.sub, false);

// Cada demonstração é um arquivo em public/media, com um poster de mesmo nome.
// Sem checar o disco: em produção o código roda fora da árvore do projeto e a checagem sempre falhava.
const media = (label: string, file: string) => ({ label, src: `/media/${file}.mp4`, poster: `/media/${file}-poster.jpg` });
// Vídeo principal: legendas ao vivo num vídeo do YouTube. O carrossel aceita mais itens quando houver gravações.
const demos = [media(t.videos.youtube, 'deathnote')];
const startAt = 0; // único vídeo, abre centralizado
// Vídeos curtos das configurações e do ditado por voz, cada um com um texto ao lado.
const spotlights = [
  { ...t.demos.config, ...media(t.demos.config.label, 'config') },
  { ...t.demos.dictation, ...media(t.demos.dictation.label, 'transcription') },
];

const features = [
  { ...t.features[0], src: '/config.png', width: 940, height: 1026 },
  { ...t.features[1], src: '/config2.png', width: 1052, height: 1024 },
];

const cloneCommands = [
  'git clone https://github.com/EduardoViniciusJ/AnyCaptions.git',
  'cd AnyCaptions',
  'npm.cmd --prefix frontend ci',
  'npm.cmd --prefix frontend run tauri -- dev',
];
const windowsIcon = 'M3 5.5 10.5 4.5v7H3zm8.5-1.2L21 3v8.5h-9.5zM3 12.5h7.5v7L3 18.5zm8.5 0H21V21l-9.5-1.4z';
---
<Layout lang={lang} title={t.title} description={t.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'AnyCaptions',
    operatingSystem: 'Windows 11',
    applicationCategory: 'UtilitiesApplication',
    description: t.jsonLd,
    url: 'https://anycaptions.app',
    image: 'https://anycaptions.app/og.png',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
    author: { '@type': 'Person', name: 'Eduardo Vinicius', url: 'https://github.com/EduardoViniciusJ' },
  })} />

  <section class="home-hero container">
    <h1>{titleWords.map((item, index) => <>{index > 0 && ' '}<span class="w" style={`--d:${item.delay}s`}>{item.word}</span></>)}</h1>
    <ul class="hero-copy">
      {heroLines.map(({ Icon, words }, lineIndex) => (
        <li>
          <Icon class="w" style={`--d:${words[0]?.delay ?? 0}s`} size={18} aria-hidden="true" />
          <span>
            {words.map((item, index) => (
              <>
                {index > 0 && ' '}
                {item.strong
                  ? <strong class="w" style={`--d:${item.delay}s`}>{item.word}</strong>
                  : <span class="w" style={`--d:${item.delay}s`}>{item.word}</span>}
              </>
            ))}
            {lineIndex === heroLines.length - 1 && <i class="caret" style={`--d:${caretDelay}s`} aria-hidden="true"></i>}
          </span>
        </li>
      ))}
    </ul>
    <div class="hero-actions" id="download">
      {hasInstaller
        ? <a class="btn hero-download" id="download-link" href={localePath(lang, '/account')} title={t.downloadSignInHint}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d={windowsIcon} /></svg>{t.download}</a>
        : <button class="btn hero-download" type="button" disabled title={t.downloadUnavailable}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d={windowsIcon} /></svg>{t.download}</button>}
    </div>
  </section>
  <script>
    import { currentAccount } from '../../features/auth/auth-api';
    const link = document.getElementById('download-link');
    if (link instanceof HTMLAnchorElement && await currentAccount()) {
      const api = (import.meta.env.PUBLIC_API_URL || '/api').replace(/\/$/, '');
      link.href = `${api}/releases/latest/download`;
      link.removeAttribute('title');
    }
  </script>

  <!-- Vídeo principal: legendas ao vivo num vídeo do YouTube. -->
  <DemoReel demos={demos} startAt={startAt} label={t.videos.youtube} playLabel={t.videos.play} goToLabel={t.videos.goTo} />

  <!-- Vídeos curtos com texto ao lado: configurações e ditado por voz. O bloco de imagens abaixo segue igual. -->
  <div class="spotlight container">
    {spotlights.map(item => (
      <section class="spotlight-row" aria-label={item.title}>
        <DemoPlayer src={item.src} poster={item.poster} label={item.label} playLabel={t.videos.play} />
        <div>
          <h2>{item.title}</h2>
          <p class="section-sub">{item.text}</p>
        </div>
      </section>
    ))}
  </div>

  <div class="showcase container">
    {features.map(feature => (
      <section class="showcase-row">
        <img class="showcase-shot skeleton" src={feature.src} width={feature.width} height={feature.height} alt={feature.alt} loading="lazy" decoding="async" />
        <div>
          <h2>{feature.title}</h2>
          <p class="section-sub">{feature.sub}</p>
          <ul class="showcase-list">
            {feature.items.map((item, index) => <li style={`--i:${index}`}><h3>{item.title}</h3><p>{item.text}</p></li>)}
          </ul>
        </div>
      </section>
    ))}
  </div>

  <script>
    // Mesmo carregamento do topo nas seções abaixo da dobra: skeleton nas capturas de tela até a
    // imagem chegar, e cada linha entra apagada e desfocada quando aparece na tela.
    document.querySelectorAll<HTMLImageElement>('img.skeleton').forEach(img => {
      const done = () => img.classList.remove('skeleton');
      if (img.complete && img.naturalWidth > 0) done();
      else { img.addEventListener('load', done, { once: true }); img.addEventListener('error', done, { once: true }); }
    });
    const rows = [...document.querySelectorAll<HTMLElement>('.spotlight-row, .showcase-row')];
    if ('IntersectionObserver' in window) {
      // A classe só entra com JavaScript, para a página nunca ficar em branco sem ele.
      rows.forEach(row => row.classList.add('reveal'));
      const seen = new IntersectionObserver(entries => entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-in');
        seen.unobserve(entry.target);
      }), { rootMargin: '0px 0px 0px 0px', threshold: 0.05 });
      rows.forEach(row => seen.observe(row));
    }
  </script>

  <section class="github container" aria-labelledby="github-title">
    <a class="github-mark w" style={`--d:${githubIconDelay}s`} href={repo} target="_blank" rel="noreferrer" aria-label="GitHub"><img src="/icons/github.svg" alt="" width="40" height="40" /></a>
    <h2 id="github-title">{githubTitleWords.map((item, index) => <>{index > 0 && ' '}<span class="w" style={`--d:${item.delay}s`}>{item.word}</span></>)}</h2>
    <p class="section-sub">{githubSubWords.map((item, index) => <>{index > 0 && ' '}<span class="w" style={`--d:${item.delay}s`}>{item.word}</span></>)}</p>
    <div class="code-box">
      <div class="mockup-code">
        {cloneCommands.map(command => <pre data-prefix="$"><code>{command}</code></pre>)}
      </div>
      <button type="button" class="btn btn-sm code-copy" data-copy={cloneCommands.join('\n')} data-copied={t.github.copied}>{t.github.copy}</button>
    </div>
    <div class="hero-actions">
      <a class="btn hero-alt" href={repo} target="_blank" rel="noreferrer">{t.github.repo}</a>
      <a class="btn hero-alt" href={`${repo}/issues/new/choose`} target="_blank" rel="noreferrer">{t.github.issues}</a>
    </div>
  </section>
  <script>
    const copyButton = document.querySelector<HTMLButtonElement>('.code-copy');
    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyButton.dataset.copy ?? '');
        const label = copyButton.textContent;
        copyButton.textContent = copyButton.dataset.copied ?? label;
        setTimeout(() => { copyButton.textContent = label; }, 1600);
      } catch { /* sem permissão de clipboard, o texto continua selecionável */ }
    });
  </script>
</Layout>
