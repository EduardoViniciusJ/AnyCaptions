---
import { existsSync } from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import { Captions, Mic, WifiOff } from '@lucide/astro';
import { getLatestRelease } from '../../lib/api/releases';
import { localePath, messages, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = messages[lang].home;
const release = await getLatestRelease();
const hasInstaller = release?.hasInstaller ?? false;
const repo = 'https://github.com/EduardoViniciusJ/AnyCaptions';

// O título e as três linhas entram palavra por palavra, como uma legenda ao vivo, em loop.
let wordIndex = 0;
const toWords = (text: string, strong: boolean) =>
  text.split(/\s+/).filter(Boolean).map(word => ({ word, strong, delay: 0.2 + 0.09 * wordIndex++ }));
const titleWords = toWords(t.heroTitle, false);
const heroIcons = [Captions, Mic, WifiOff];
const heroLines = t.heroLines.map((line, index) => ({
  Icon: heroIcons[index] ?? Captions,
  words: [...toWords(line.lead, true), ...toWords(line.rest, false)],
}));
const caretDelay = 0.2 + 0.09 * wordIndex;

// Cada demonstração espera um arquivo em public/media. Enquanto a gravação
// definitiva não existe, o vídeo provisório entra no lugar.
type Demo = { label: string; file: string; fallback: string };
function media(demo: Demo) {
  const ready = existsSync(new URL(`../../../public/media/${demo.file}.mp4`, import.meta.url));
  const name = ready ? demo.file : demo.fallback;
  return { label: demo.label, src: `/media/${name}.mp4`, poster: `/media/${name}-poster.jpg` };
}
const demos = [
  { label: t.videos.amongUs, file: 'among-us', fallback: 'cs2v1' },
  { label: t.videos.youtube, file: 'youtube', fallback: 'cs2v1' },
  { label: t.videos.game, file: 'game', fallback: 'cs2v1' },
].map(media);
const startAt = 1; // o vídeo do meio abre centralizado, com um vizinho de cada lado

// `loading` em <video> ainda não consta nos tipos do Astro; o navegador o entende.
const lazy = { loading: 'lazy' } as Record<string, string>;
const cloneCommands = [
  'git clone https://github.com/EduardoViniciusJ/AnyCaptions.git',
  'cd AnyCaptions',
  'npm.cmd --prefix frontend ci',
  'npm.cmd --prefix frontend run tauri -- dev',
];
const windowsIcon = 'M3 5.5 10.5 4.5v7H3zm8.5-1.2L21 3v8.5h-9.5zM3 12.5h7.5v7L3 18.5zm8.5 0H21V21l-9.5-1.4z';
---
<Layout lang={lang} title={t.title} description={t.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'AnyCaptions',
    operatingSystem: 'Windows 11',
    applicationCategory: 'UtilitiesApplication',
    description: t.jsonLd,
    url: 'https://anycaptions.app',
    image: 'https://anycaptions.app/og.png',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
    author: { '@type': 'Person', name: 'Eduardo Vinicius', url: 'https://github.com/EduardoViniciusJ' },
  })} />

  <section class="home-hero container">
    <h1>{titleWords.map((item, index) => <>{index > 0 && ' '}<span class="w" style={`--d:${item.delay}s`}>{item.word}</span></>)}</h1>
    <ul class="hero-copy">
      {heroLines.map(({ Icon, words }, lineIndex) => (
        <li>
          <Icon class="w" style={`--d:${words[0]?.delay ?? 0}s`} size={18} aria-hidden="true" />
          <span>
            {words.map((item, index) => (
              <>
                {index > 0 && ' '}
                {item.strong
                  ? <strong class="w" style={`--d:${item.delay}s`}>{item.word}</strong>
                  : <span class="w" style={`--d:${item.delay}s`}>{item.word}</span>}
              </>
            ))}
            {lineIndex === heroLines.length - 1 && <i class="caret" style={`--d:${caretDelay}s`} aria-hidden="true"></i>}
          </span>
        </li>
      ))}
    </ul>
    <div class="hero-actions" id="download">
      {hasInstaller
        ? <a class="btn hero-download" id="download-link" href={localePath(lang, '/account')} title={t.downloadSignInHint}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d={windowsIcon} /></svg>{t.download}</a>
        : <button class="btn hero-download" type="button" disabled title={t.downloadUnavailable}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d={windowsIcon} /></svg>{t.download}</button>}
    </div>
  </section>
  <script>
    import { currentAccount } from '../../features/auth/auth-api';
    const link = document.getElementById('download-link');
    if (link instanceof HTMLAnchorElement && await currentAccount()) {
      const api = (import.meta.env.PUBLIC_API_URL || '/api').replace(/\/$/, '');
      link.href = `${api}/releases/latest/download`;
      link.removeAttribute('title');
    }
  </script>

  <!-- Carrossel: um vídeo no centro e um vizinho apagado de cada lado.
       Clicar num vizinho, arrastar ou usar as setas do teclado troca o vídeo. -->
  <section class="reel" aria-label={t.videos.amongUs}>
    <div class="reel-track" tabindex="0" aria-roledescription="carousel" data-start={startAt}>
      {demos.map((demo, index) => (
        <figure class:list={['reel-slide', { 'is-active': index === startAt }]} aria-roledescription="slide" aria-label={demo.label} data-index={index}>
          <div class="demo-frame">
            <video class="skeleton" controls muted loop playsinline preload={index === startAt ? 'metadata' : 'none'} {...(index === startAt ? {} : lazy)} src={demo.src} poster={demo.poster} width="1920" height="1080" aria-label={demo.label}></video>
            <button type="button" class="reel-pick" data-go={index} aria-label={t.videos.goTo.replace('{n}', String(index + 1))}></button>
          </div>
        </figure>
      ))}
    </div>
  </section>
  <script>
    const track = document.querySelector<HTMLElement>('.reel-track');
    if (track) {
      const slides = [...track.querySelectorAll<HTMLElement>('.reel-slide')];
      let active = Number(track.dataset.start ?? 0);
      const goTo = (index: number, behavior: ScrollBehavior = 'smooth') => {
        const target = slides[Math.max(0, Math.min(slides.length - 1, index))];
        if (!target) return;
        const left = target.offsetLeft - track.offsetLeft - (track.clientWidth - target.clientWidth) / 2;
        track.scrollTo({ left, behavior });
      };
      const setActive = (index: number) => {
        active = index;
        slides.forEach((slide, i) => {
          slide.classList.toggle('is-active', i === index);
          // Um vídeo que saiu do centro não continua tocando escondido.
          if (i !== index) slide.querySelector('video')?.pause();
        });
      };
      track.querySelectorAll<HTMLButtonElement>('.reel-pick').forEach(button =>
        button.addEventListener('click', () => goTo(Number(button.dataset.go))));
      track.addEventListener('keydown', event => {
        if (event.key === 'ArrowRight') { event.preventDefault(); goTo(active + 1); }
        if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(active - 1); }
      });
      // O ativo vem da posição no trilho, sem contar transformações: o giro 3D distorce a área visível dos vizinhos.
      const updateActive = () => {
        const center = track.scrollLeft + track.clientWidth / 2;
        let nearest = 0;
        slides.forEach((slide, i) => {
          const distance = (el: HTMLElement) => Math.abs(el.offsetLeft - track.offsetLeft + el.clientWidth / 2 - center);
          if (distance(slide) < distance(slides[nearest]!)) nearest = i;
        });
        if (nearest !== active || !slides[nearest]?.classList.contains('is-active')) setActive(nearest);
      };
      let frame = 0;
      track.addEventListener('scroll', () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(updateActive); }, { passive: true });
      // Skeleton atrás de cada vídeo até o poster carregar.
      track.querySelectorAll('video').forEach(video => {
        const done = () => video.classList.remove('skeleton');
        const poster = new Image();
        poster.onload = done;
        poster.onerror = done;
        poster.src = video.poster;
      });
      goTo(active, 'instant');
      updateActive();
    }
  </script>

  <section class="github container" aria-labelledby="github-title">
    <a class="github-mark" href={repo} target="_blank" rel="noreferrer" aria-label="GitHub"><img src="/icons/github.svg" alt="" width="40" height="40" /></a>
    <h2 id="github-title">{t.github.title}</h2>
    <p class="section-sub">{t.github.sub}</p>
    <div class="code-box">
      <div class="mockup-code">
        {cloneCommands.map(command => <pre data-prefix="$"><code>{command}</code></pre>)}
      </div>
      <button type="button" class="btn btn-sm code-copy" data-copy={cloneCommands.join('\n')} data-copied={t.github.copied}>{t.github.copy}</button>
    </div>
    <div class="hero-actions">
      <a class="btn hero-alt" href={repo} target="_blank" rel="noreferrer">{t.github.repo}</a>
      <a class="btn hero-alt" href={`${repo}/issues/new/choose`} target="_blank" rel="noreferrer">{t.github.issues}</a>
    </div>
  </section>
  <script>
    const copyButton = document.querySelector<HTMLButtonElement>('.code-copy');
    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyButton.dataset.copy ?? '');
        const label = copyButton.textContent;
        copyButton.textContent = copyButton.dataset.copied ?? label;
        setTimeout(() => { copyButton.textContent = label; }, 1600);
      } catch { /* sem permissão de clipboard, o texto continua selecionável */ }
    });
  </script>
</Layout>
