---
import Layout from '../../layouts/Layout.astro';
import { htmlLang, localePath, type Lang } from '../../i18n';
import { guideMessages, guideSlugs, type GuideSlug } from '../../i18n/guides';
interface Props { lang: Lang; slug: GuideSlug }
const { lang, slug } = Astro.props;
const t = guideMessages[lang];
const guide = t.guides[slug];
const site = 'https://anycaptions.app';
const url = `${site}${localePath(lang, `/guides/${slug}`)}`;
const others = guideSlugs.filter(item => item !== slug);
// Where the facts about Windows in the comparison come from.
const windowsSource = 'https://support.microsoft.com/en-us/accessibility/windows/use-live-captions-to-better-understand-audio';
// The same questions, steps and path the page shows, in the form search
// engines and assistants read.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      inLanguage: htmlLang[lang],
      mainEntity: guide.faq.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
    },
    {
      '@type': 'HowTo',
      name: guide.steps.heading,
      inLanguage: htmlLang[lang],
      step: guide.steps.items.map((text, index) => ({ '@type': 'HowToStep', position: index + 1, text })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'AnyCaptions', item: `${site}${localePath(lang, '/')}` },
        { '@type': 'ListItem', position: 2, name: t.label, item: `${site}${localePath(lang, '/guides')}` },
        { '@type': 'ListItem', position: 3, name: guide.title, item: url },
      ],
    },
  ],
};
---
<Layout lang={lang} title={guide.title} description={guide.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="guide-page container">
    <nav class="guide-crumbs" aria-label={t.label}><a href={localePath(lang, '/guides')}>{t.label}</a></nav>
    <h1>{guide.title}</h1>
    <p class="guide-answer">{guide.answer}</p>
    <div class="guide-actions">
      <a class="btn hero-download" href={`${localePath(lang, '/')}#download`}>{t.download}</a>
      <a class="btn hero-alt" href={localePath(lang, '/docs')}>{t.docs}</a>
    </div>
    <section><h2>{guide.steps.heading}</h2><ol>{guide.steps.items.map(item => <li>{item}</li>)}</ol></section>
    {guide.table && (
      <section>
        <h2>{guide.table.heading}</h2>
        <div class="guide-table">
          <table>
            <thead><tr>{guide.table.headers.map(header => <th scope="col">{header}</th>)}</tr></thead>
            <tbody>{guide.table.rows.map(row => <tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="guide-source">{guide.table.source.before}<a href={windowsSource} target="_blank" rel="noreferrer">{guide.table.source.link}</a>{guide.table.source.after}</p>
      </section>
    )}
    {guide.sections.map(section => <section><h2>{section.heading}</h2>{section.paragraphs.map(text => <p>{text}</p>)}</section>)}
    <section class="faq"><h2>{t.faqHeading}</h2>{guide.faq.map(item => <div class="faq-item"><h3>{item.q}</h3><p>{item.a}</p></div>)}</section>
    <section>
      <h2>{t.more}</h2>
      <ul class="guide-more">{others.map(item => <li><a href={localePath(lang, `/guides/${item}`)}>{t.guides[item].title}</a></li>)}</ul>
    </section>
  </article>
</Layout>
